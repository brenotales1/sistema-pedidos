# ==============================================================================
# Configuracoes de Ambiente — Sistema de Pedidos e Controle de Estoque
# ==============================================================================

# Ponto de entrada e modo de execucao do Flask
FLASK_APP=app.py
FLASK_ENV=development

# Chave secreta de sessao Flask (alterar em producao)
SECRET_KEY=dev-secret-key-change-in-production

# Conexao com Banco de Dados
# SQLite 3 local (padrao para desenvolvimento local e testes automatizados):
DATABASE_URL=sqlite:///database.db

# Exemplo de conexao para PostgreSQL em ambiente de producao:
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/sistema_pedidos

# ==============================================================================
# Integracao WhatsApp (Meta Cloud API oficial) — Sprint 3 (US #8 e #9)
# ==============================================================================
# Habilita o disparo de mensagens reais
WHATSAPP_ENABLED=false

# Identificacao do numero de telefone da Meta (Phone number ID)
META_PHONE_NUMBER_ID=

# Token de acesso permanente da Meta (System User Token)
META_ACCESS_TOKEN=

# Nome do modelo aprovado na Meta (ex: pedido_finalizado)
META_TEMPLATE_NAME=pedido_finalizado
META_TEMPLATE_LANG=pt_BR

# Senha secreta para o Webhook de retorno (se for usar)
META_VERIFY_TOKEN=visual_estoque_token_2026
