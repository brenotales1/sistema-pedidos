# ==============================================================================
# Configuracoes de Ambiente — Sistema de Pedidos e Controle de Estoque
# ==============================================================================

# Ponto de entrada e modo de execucao do Flask
FLASK_APP=app.py
FLASK_ENV=development

# Chave secreta de sessao Flask (alterar em producao)
SECRET_KEY=dev-secret-key-change-in-production

# Conexao com Banco de Dados
# SQLite 3 local (padrao para desenvolvimento local e testes automatizados):
DATABASE_URL=sqlite:///database.db

# Exemplo de conexao para PostgreSQL em ambiente de producao:
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/sistema_pedidos

# Integracao WhatsApp (Planejada para Sprint 3 — Notificacoes de Pedidos)
# WHATSAPP_API_URL=https://api.whatsapp.exemplo.com/v1/messages
# WHATSAPP_API_TOKEN=seu_token_aqui
